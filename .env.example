# Copy to .env (never commit .env) and export before live runs:
#   cp .env.example .env && set -a && source .env && set +a
# Replay mode (the default, and what CI uses) needs none of these.

# Needed only for `make record` and `ga ask --mode live`.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are shown.
GA_GENERATOR_MODEL=claude-opus-5-5
GA_JUDGE_MODEL=claude-sonnet-5-5

# Server side refusal fallbacks: default or off.
GA_FALLBACKS=default

# Hard stop for record and live runs, in US dollars.
GA_BUDGET_USD=2.00

# Where the local embedding and rerank models are kept (about 150 MB).
# GA_MODELS_DIR=.cache/models
